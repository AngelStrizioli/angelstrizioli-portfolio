{
  "buildCommand": "node build.mjs",
  "outputDirectory": ".",
  "cleanUrls": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/r/:src", "destination": "/index.html" },
    { "source": "/es/r/:src", "destination": "/es/index.html" },
    { "source": "/pt/r/:src", "destination": "/pt/index.html" }
  ],
  "redirects": [
    {
      "source": "/cv",
      "destination": "/cv.html",
      "permanent": true
    },
    {
      "source": "/es/cv",
      "destination": "/es/cv.html",
      "permanent": true
    },
    {
      "source": "/pt/cv",
      "destination": "/pt/cv.html",
      "permanent": true
    },
    {
      "source": "/assets/Angel_Strizioli_CV.pdf",
      "destination": "/assets/Angel_Strizioli_CV_en.pdf",
      "permanent": true
    }
  ]
}
